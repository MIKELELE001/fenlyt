# Copy to .env.local (Next.js runtime) and .env (Prisma CLI). Keep DATABASE_URL
# in sync across both. Never commit real secrets — this file is a template only.

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database — PostgreSQL (Neon/Supabase) in production.
# DATABASE_URL: pooled connection string (used by the app at runtime).
# DIRECT_URL:   direct connection (used by `prisma db push` / migrations).
# Neon example (note ?pgbouncer=true on the pooled URL):
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/scribe?sslmode=require&pgbouncer=true"
#   DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/scribe?sslmode=require"
DATABASE_URL=
DIRECT_URL=

# AI — server-side only, never exposed to the client.
GROQ_API_KEY=

# Auth (Auth.js / NextAuth v5 — Google sign-in). All server-side.
# AUTH_SECRET: generate with `npx auth secret` (or `openssl rand -base64 32`).
# AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET: from a Google Cloud OAuth 2.0 client.
#   Authorized redirect URIs must include:
#     http://localhost:3000/api/auth/callback/google
#     https://YOUR-VERCEL-DOMAIN/api/auth/callback/google
# AUTH_URL: your canonical app URL (set to the prod domain on Vercel).
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=http://localhost:3000

# Payments
PAYMENT_MODE=mock                                 # "mock" | "real"
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=                             # required for real transfers
CIRCLE_TREASURY_WALLET_ID=                        # developer-controlled wallet id
# Developer-Controlled Wallets (Web3 Services) always use api.circle.com —
# testnet vs mainnet is set by the wallet's blockchain, NOT a sandbox host.
# (The SDK defaults to this; the app does not read CIRCLE_BASE_URL.)
CIRCLE_BASE_URL=https://api.circle.com
ARC_RPC_URL=
ARC_CHAIN_ID=
SCRIBE_TREASURY_WALLET=
SCRIBE_TREASURY_PRIVATE_KEY=
